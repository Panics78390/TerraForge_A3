{
  "name": "terraforge-a3",
  "version": "1.2.4",
  "private": true,
  "type": "module",
  "description": "Éditeur de terrain simplifié pour Arma 3 (aperçu 3D en direct, exports Terrain Builder)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "build:pages": "vite build --mode single && mkdir -p docs && cp dist-single/index.html docs/index.html",
    "app": "vite build --mode single && electron .",
    "dist:win": "vite build --mode single && electron-builder --win --publish never"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "leaflet": "^1.9.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "7.1.5",
    "vite-plugin-singlefile": "2.3.0"
  },
  "productName": "TerraForge",
  "author": "TerraForge",
  "main": "electron/main.cjs",
  "build": {
    "appId": "fr.terraforge.a3",
    "productName": "TerraForge",
    "files": [
      "electron/**",
      "dist-single/**",
      "build/icon.png",
      "build/splash.jpg",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TerraForge-Installation-${version}.exe",
      "shortcutName": "TerraForge"
    },
    "portable": {
      "artifactName": "TerraForge-Portable-${version}.exe"
    }
  }
}
